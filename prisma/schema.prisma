generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum EventType {
  OPEN_MIC
  JAM_SESSION
  COMEDY_NIGHT
  POETRY_SLAM
  OPEN_STAGE
  WORKSHOP
  OPEN_STUDIO
}

enum SignUpMethod {
  DOOR
  ONLINE
  APP
}

enum EventSource {
  MANUAL         // user-submitted or seeded
  EVENTBRITE     // ingested from Eventbrite API
  VENUE_SCRAPER  // scraped from a venue website via Playwright + Gemini
}

enum ScrapeStrategy {
  ICAL           // iCal/RSS feed discovery
  STATIC_HTML    // HTTP fetch + JSON-LD / CSS selectors (no browser)
  PLAYWRIGHT_HTML // Browser render + JSON-LD / CSS selectors
  LLM_TEXT       // Cleaned HTML → Gemini Flash
  VISION         // Screenshot → Vision model (last resort)
}

enum PerformerType {
  MUSICIAN
  COMEDIAN
  POET
  STORYTELLER
  OTHER
}

enum SignupStatus {
  SIGNED_UP
  PERFORMED
  NO_SHOW
  REMOVED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id        String   @id // Clerk user ID — never auto-generated
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Performer identity — all optional
  displayName      String?
  bio              String?
  avatarUrl        String?
  instagramHandle  String?
  tiktokHandle     String?
  performerType    PerformerType?
  instruments      String[]       @default([])
  genres           String[]       @default([])
  performanceCount Int            @default(0)

  events     Event[]
  signups    EventSignup[]
  attendees  EventAttendee[]
  hostedEvents Event[] @relation("HostedEvents")
}

model Venue {
  id              String  @id @default(cuid())
  name            String
  address         String
  neighborhood    String?
  city            String
  state           String
  lat             Float?
  lng             Float?
  instagramHandle String?

  events Event[]
}

/**
 * Persists per-venue scrape state across runs.
 * Allows the pipeline to skip straight to the last known working tier
 * and skip processing entirely when the page content hasn't changed.
 */
model VenueScrapeState {
  url                 String          @id  // events page URL — stable identifier
  venueName           String
  lastScrapedAt       DateTime?
  successfulTier      ScrapeStrategy?      // last tier that returned events
  htmlHash            String?              // SHA-256 prefix of last-seen page content
  consecutiveFailures Int             @default(0)
  lastError           String?
  updatedAt           DateTime        @updatedAt

  // ── Tier 3 (Vision) state ──────────────────────────────────────────────────
  tier3LastCalledAt        DateTime?        // last time a live Gemini call was made
  tier3CachedAt            DateTime?        // timestamp of last successful Tier 3 result
  tier3CachedEvents        Json?            // ScrapedEvent[] from last successful call
  tier3ConsecutiveFailures Int    @default(0) // consecutive weekly failures
  tier3Suspended           Boolean @default(false) // true after 3 consecutive failures
}

model Tier3Log {
  id         String   @id @default(cuid())
  url        String
  venueName  String
  invokedAt  DateTime @default(now())
  succeeded  Boolean
  eventCount Int      @default(0)
  fromCache  Boolean  @default(false)
  error      String?

  @@index([url, invokedAt])
}

model ScraperRun {
  id       String   @id @default(cuid())
  city     String
  state    String
  source   String   @default("claude") // "claude" | "eventbrite"
  ranAt    DateTime @default(now())
  inserted Int
  skipped  Int

  @@index([city, state, source, ranAt])
}

model Event {
  id                   String       @id @default(cuid())
  venueId              String
  city                 String?      // denormalized from venue for fast filtering
  state                String?
  title                String
  description          String?
  startsAt             DateTime
  endsAt               DateTime?
  type                 EventType
  genres               String[]
  coverCharge          String?      // "Free", "$5", "$10 at door"
  slotDuration         String?      // "5 min", "3 songs", "Open"
  backline             String[]
  signUpMethod         SignUpMethod @default(DOOR)
  isRecurring          Boolean      @default(false)
  recurringDescription String?
  submittedBy          String?      // optional Clerk user ID
  source               EventSource  @default(MANUAL)
  externalId           String?      // external API event ID (Eventbrite, etc.)
  sourceUrl            String?      // URL of the page this event was scraped from
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  // Sign-up management
  signupsEnabled Boolean @default(false)
  maxSlots       Int?
  hostId         String? // user who manages this event's roster

  coverImageUrl          String?
  coverImageThumb        String?
  coverImagePhotographer String?
  coverImagePhotographerUrl String?
  coverImageAttribution  String?

  venue     Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  submitter User?           @relation(fields: [submittedBy], references: [id])
  host      User?           @relation("HostedEvents", fields: [hostId], references: [id])
  signups   EventSignup[]
  attendees EventAttendee[]

  @@unique([source, externalId])
  @@index([city, startsAt])   // city filter + date range — most common query pattern
  @@index([hostId])           // host's event roster lookup
  @@index([submittedBy])      // user's submitted events
  @@index([startsAt])         // date range queries without city filter
}

model EventSignup {
  id            String        @id @default(cuid())
  eventId       String
  userId        String
  performerType PerformerType?
  instruments   String[]      @default([])
  genres        String[]      @default([])
  note             String?  // optional note to host
  instagramHandle  String?  // optional — shown on public roster
  tiktokHandle     String?  // optional — shown on public roster
  slotOrder     Int?          // set by host when reordering
  status        SignupStatus  @default(SIGNED_UP)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, status])  // slot counting on every signup creation
}

model EventAttendee {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}
