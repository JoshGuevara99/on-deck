generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum EventType {
  OPEN_MIC
  JAM_SESSION
  COMEDY_NIGHT
  POETRY_SLAM
  OPEN_STAGE
  WORKSHOP
  OPEN_STUDIO
}

enum SignUpMethod {
  DOOR
  ONLINE
  APP
}

enum PerformerType {
  MUSICIAN
  COMEDIAN
  POET
  STORYTELLER
  OTHER
}

enum SignupStatus {
  SIGNED_UP
  PERFORMED
  NO_SHOW
  REMOVED
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id        String   @id // Clerk user ID — never auto-generated
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Performer identity — all optional
  displayName      String?
  bio              String?
  avatarUrl        String?
  performerType    PerformerType?
  instruments      String[]       @default([])
  genres           String[]       @default([])
  performanceCount Int            @default(0)

  events     Event[]
  signups    EventSignup[]
  attendees  EventAttendee[]
  hostedEvents Event[] @relation("HostedEvents")
}

model Venue {
  id              String  @id @default(cuid())
  name            String
  address         String
  neighborhood    String?
  city            String
  state           String
  lat             Float?
  lng             Float?
  instagramHandle String?

  events Event[]
}

model ScraperRun {
  id       String   @id @default(cuid())
  city     String
  state    String
  ranAt    DateTime @default(now())
  inserted Int
  skipped  Int

  @@index([city, state, ranAt])
}

model Event {
  id                   String       @id @default(cuid())
  venueId              String
  city                 String?      // denormalized from venue for fast filtering
  state                String?
  title                String
  description          String?
  startsAt             DateTime
  endsAt               DateTime?
  type                 EventType
  genres               String[]
  coverCharge          String?      // "Free", "$5", "$10 at door"
  slotDuration         String?      // "5 min", "3 songs", "Open"
  backline             String[]
  signUpMethod         SignUpMethod @default(DOOR)
  isRecurring          Boolean      @default(false)
  recurringDescription String?
  submittedBy          String?      // optional Clerk user ID
  isApproved           Boolean      @default(true)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  // Sign-up management
  signupsEnabled Boolean @default(false)
  maxSlots       Int?
  hostId         String? // user who manages this event's roster

  coverImageUrl          String?
  coverImageThumb        String?
  coverImagePhotographer String?
  coverImagePhotographerUrl String?
  coverImageAttribution  String?

  venue     Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  submitter User?           @relation(fields: [submittedBy], references: [id])
  host      User?           @relation("HostedEvents", fields: [hostId], references: [id])
  signups   EventSignup[]
  attendees EventAttendee[]
}

model EventSignup {
  id            String        @id @default(cuid())
  eventId       String
  userId        String
  performerType PerformerType?
  instruments   String[]      @default([])
  genres        String[]      @default([])
  note             String?  // optional note to host
  instagramHandle  String?  // optional — shown on public roster
  tiktokHandle     String?  // optional — shown on public roster
  slotOrder     Int?          // set by host when reordering
  status        SignupStatus  @default(SIGNED_UP)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model EventAttendee {
  id        String   @id @default(cuid())
  eventId   String
  userId    String
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}
