{
  "name": "on-deck",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "prisma generate && pnpm --filter './packages/*' build && pnpm --filter './apps/*' build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts"
  },
  "pnpm": {
    "overrides": {
      "expo-crypto": "~13.0.2"
    }
  },
  "devDependencies": {
    "prisma": "^6.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
