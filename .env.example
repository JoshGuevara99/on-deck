# Copy this file to .env and fill in the values. Never commit .env.

# ── Database ──────────────────────────────────────────────────────────────────
# Local (no Docker):  postgresql://localhost/ondeck
# Docker Compose:     postgresql://ondeck:<your-pass>@localhost:5432/ondeck
DATABASE_URL=

# Used by docker-compose.yml only
POSTGRES_USER=ondeck
POSTGRES_PASSWORD=
POSTGRES_DB=ondeck

# ── API ───────────────────────────────────────────────────────────────────────
PORT=3000
# Comma-separated list of allowed CORS origins. Must be set in production.
# Example: https://ondeck.app,https://app.ondeck.app
ALLOWED_ORIGINS=

# ── Mobile app ────────────────────────────────────────────────────────────────
# iOS Simulator / Android Emulator pointing at your laptop:
#   EXPO_PUBLIC_API_URL=http://localhost:3000        (iOS sim)
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:3000         (Android emulator)
# Real device on same Wi-Fi:
#   EXPO_PUBLIC_API_URL=http://192.168.x.x:3000      (your machine's LAN IP)
EXPO_PUBLIC_API_URL=http://localhost:3000

# ── AI Scraper ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Venue scraper (Gemini Flash — free tier, 1M tokens/day) ───────────────────
# Get a free key at https://aistudio.google.com
GEMINI_API_KEY=

# ── Tier 3 toggles ────────────────────────────────────────────────────────────
# TIER3_SAVE_SCREENSHOTS=true   → save each Tier 3 screenshot to apps/scraper/debug/screenshots/
# TIER3_GEMINI_ENABLED=true     → actually call Gemini; set false to inspect screenshots only
TIER3_SAVE_SCREENSHOTS=false
TIER3_GEMINI_ENABLED=true

# ── Event Aggregation ─────────────────────────────────────────────────────────
# Eventbrite: https://www.eventbrite.com/platform/api — free, get a personal OAuth token
EVENTBRITE_API_KEY=

# ── Clerk ─────────────────────────────────────────────────────────────────────
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# ── Unsplash ──────────────────────────────────────────────────────────────────
UNSPLASH_ACCESS_KEY=
